# RetinaScan AI — backend environment
# All variables are OPTIONAL. Defaults keep the local demo working with zero setup.

# Require an X-API-Key header on all API endpoints (empty = auth disabled).
RETINASCAN_API_KEY=

# Max accepted upload size in MB.
RETINASCAN_MAX_UPLOAD_MB=10

# Requests per minute per client IP on inference endpoints.
RETINASCAN_RATE_LIMIT_PER_MIN=30

# Comma-separated CORS origins ("*" for local demos).
RETINASCAN_ALLOWED_ORIGINS=*
