# RetinaScan AI — backend (FastAPI + ONNX inference + Grad-CAM)
# Image size note: CPU-only torch keeps this at roughly 2.2 GB
# (torch CPU wheels + opencv + onnxruntime). CUDA builds would exceed 7 GB.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# libglib2.0-0 is required by opencv(-headless); libgl1 covers non-headless fallbacks
RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# CPU-only torch first so the CUDA wheels (default on PyPI linux) are never pulled;
# the later `-r requirements.txt` sees torch/torchvision already satisfied.
RUN pip install torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r requirements.txt

COPY src/ ./src/
COPY demo_images/ ./demo_images/
COPY models/onnx/ ./models/onnx/
# .pth checkpoint is only needed server-side for Grad-CAM (/api/explain)
COPY models/classification/best_classifier.pth ./models/classification/best_classifier.pth

# /app/data holds uploads, the uint8 preprocess cache, and retinascan.db
# (mount a volume here to persist visit history across container restarts)
RUN mkdir -p /app/data
VOLUME /app/data

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

CMD ["uvicorn", "src.api.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
